# Copy to .env locally and chmod 600. Empty secrets deliberately block startup.
# Supply independent credentials through your authorized secret workflow.
# Do not commit .env or put real credentials into this example.
# Four separate secret files, already provisioned locally; never put values here.
POSTGRES_BOOTSTRAP_PASSWORD_FILE=
POSTGRES_MIGRATION_PASSWORD_FILE=
POSTGRES_RUNTIME_PASSWORD_FILE=
POSTGRES_BACKUP_PASSWORD_FILE=
# Fixed audited database identities; operations reject mismatched values.
DATABASE_NAME=gateway
MAINTENANCE_DATABASE_USER=gateway_migrate
BACKUP_DATABASE_USER=gateway_backup
# Runtime URL: postgresql://gateway_runtime:<URL-encoded runtime password>@postgres:5432/gateway
DATABASE_URL=
# One-shot migration/restore URL, never injected into the gateway service.
# postgresql://gateway_migrate:<URL-encoded migration password>@postgres:5432/gateway
MIGRATION_DATABASE_URL=
LITELLM_MASTER_KEY=
# Keep stable across upgrades/restores; replacing this may make encrypted data unreadable.
LITELLM_SALT_KEY=
CONSUMER_PORT=4000
ADMIN_PORT=4001
# Only set for a reviewed immutable release; default is repository config/.
# GATEWAY_CONFIG_DIR=/absolute/path/to/config
# Provider variables are intentionally absent. Add only after account qualification.
